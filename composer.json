{
    "name": "ashik/version-updater",
    "description": "Reusable local version updater for Laravel applications.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Ashik\\VersionUpdater\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ashik\\VersionUpdater\\VersionUpdaterServiceProvider"
            ]
        }
    }
}
